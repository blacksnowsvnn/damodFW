# --- Cấu hình chung ---
APP_NAME=DamodProject
DOMAIN=localhost

# --- Backend (FastAPI) ---
POSTGRES_USER=damod_user
POSTGRES_PASSWORD=damod_password
POSTGRES_DB=damod_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://damod_user:damod_password@db:5432/damod_db
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_password

# --- Frontend (Next.js) ---
# NEXT_PUBLIC_API_URL có thể là đường dẫn tương đối (nếu dùng proxy) hoặc URL đầy đủ
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_APP_NAME=DamodProject
