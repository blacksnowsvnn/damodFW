# --- Cấu hình chung ---
APP_NAME=DamodProject
DOMAIN=localhost

# --- Backend (FastAPI) ---
# Thông tin kết nối DB của ứng dụng (được tạo tự động khi install)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app_user:changeme@db:5432/app_db

# JWT Secret Key (Nên thay đổi bằng chuỗi ngẫu nhiên dài)
SECRET_KEY=yoursecretkeyhere

# CORS: Danh sách các origin được phép truy cập API
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000

# --- pgAdmin ---
# Tài khoản đăng nhập pgAdmin (mặc định sẽ đồng bộ với admin hệ thống sau khi install)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# --- Frontend (Next.js) ---
# URL API cho frontend (mặc định qua proxy nginx là /backend)
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_APP_NAME=DamodProject
